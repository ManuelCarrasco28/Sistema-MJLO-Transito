# ====================================================
# DOCKER: frontend dentro de docker-compose
# El navegador llama /api al contenedor frontend y Vite lo proxya a http://backend
# ====================================================
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://backend


# ====================================================
# LOCAL SIN DOCKER: frontend corriendo en tu PC
# Copiar este bloque y pegarlo en .env
# ====================================================
# VITE_API_BASE_URL=/api
# VITE_BACKEND_URL=http://127.0.0.1:8080
