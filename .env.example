# Copia este archivo como .env (el .env NO se sube a GitHub) y completa los valores.

# Base de datos (docker-compose)
MYSQL_DATABASE=transitomunicipal
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena
CI_ENVIRONMENT=development

# Backend (CodeIgniter 4)
database.default.hostname=db
database.default.database=transitomunicipal
database.default.username=root
database.default.password=cambia_esta_contrasena
database.default.DBDriver=MySQLi
database.default.port=3306
app.baseURL=http://localhost:8080/

# Mínimo 32 caracteres aleatorios: firma las sesiones.
app.sessionSecret=
# Clave de cifrado de secretos guardados en la base (token PIDE). Generar con:  php spark key:generate
# Si se pierde o se cambia, los secretos ya cifrados quedan ilegibles: guárdala aparte de los respaldos de la base.
encryption.key=
# true = las rutas expuestas a roles bajos dejan de aceptar ids numéricos y exigen uuid (activar cuando la app móvil ya use uuid).
app.uuidEstricto=false
# Clave compartida con la app móvil (obligatoria para saltarse el captcha en producción). Generar: php -r "echo bin2hex(random_bytes(24));"
# La app la recibe con --dart-define=MOBILE_KEY=... (mobile/run-dev.* la toma de aquí). Vacía = comportamiento anterior.
app.mobileKey=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_BACKEND_URL=http://localhost:8080

# App móvil (Flutter): IP de TU PC en la red Wi-Fi. Cambia según la red; la usa mobile/run-dev.ps1 (o run-dev.sh).
MOBILE_API_URL=http://192.168.0.10:8080/api
