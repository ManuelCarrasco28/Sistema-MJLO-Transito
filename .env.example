# Copie este archivo a .env y complete los valores. NO suba el .env al repositorio.

# --- Base de datos ---
MYSQL_DATABASE=transitomunicipal
MYSQL_ROOT_PASSWORD=cambie-esta-clave

# --- Backend (CodeIgniter 4) ---
CI_ENVIRONMENT=development
database.default.hostname=db
database.default.database=transitomunicipal
database.default.username=root
database.default.password=cambie-esta-clave
database.default.DBDriver=MySQLi
database.default.port=3306
app.baseURL=http://localhost:8080/
app.sessionSecret=genere-un-texto-largo-y-aleatorio
# Clave de cifrado de secretos guardados en la base (token PIDE). Genérela una vez y no la cambie.
encryption.key=
# Opcional: clave compartida con la app móvil (encabezado X-Mobile-Key) para omitir el captcha
# app.mobileKey=
# Opcional: clave secreta de Cloudflare Turnstile (captcha del login web)
# turnstile.secretKey=

# --- Frontend (Vite / React) ---
CHOKIDAR_USEPOLLING=true
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://backend:80
VITE_TINYMCE_API_KEY=

# --- App móvil (Flutter) ---
# IP de su PC en la red local cuando prueba en un celular físico
MOBILE_API_URL=http://192.168.0.10:8080/api
