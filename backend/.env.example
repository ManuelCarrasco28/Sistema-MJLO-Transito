# ====================================================
# ENTORNO DE LA APLICACIÓN
# ====================================================
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# Secreto para firma de cookies de sesión (HMAC SHA-256).
# OBLIGATORIO en producción: generar una cadena aleatoria segura de al menos 32 caracteres.
app.sessionSecret = 'CAMBIAR_POR_UN_SECRETO_SEGURO_Y_ALEATORIO_DE_MINIMO_32_CARACTERES'

# Verificación SSL para peticiones a servicios PIDE (RENIEC / SUNARP)
# Por defecto true en producción.
app.pideSslVerify = true

# ====================================================
# DOCKER: backend dentro de docker-compose
# ====================================================
database.default.hostname = db
database.default.database = transitomunicipal
database.default.username = root
database.default.password = TU_PASSWORD_SEGURO_DE_MYSQL
database.default.DBDriver = MySQLi
database.default.port = 3306

# ====================================================
# LOCAL SIN DOCKER: backend corriendo en PC y DB en puerto 3307
# ====================================================
# database.default.hostname = 127.0.0.1
# database.default.database = transitomunicipal
# database.default.username = root
# database.default.password = TU_PASSWORD_SEGURO_DE_MYSQL
# database.default.DBDriver = MySQLi
# database.default.port = 3307

# ====================================================
# SEGURIDAD ADICIONAL (Opcional en dev, recomendado en prod)
# ====================================================
# turnstile.secretKey = 'TU_CLAVE_SECRETA_CLOUDFLARE_TURNSTILE'

# Nota: La UIT vigente y el token de PIDE (RENIEC/SUNARP) se gestionan desde el sistema (municipalidad_anio).
