# ====================================================
# DOCKER: backend dentro de docker-compose
# Copiar este bloque y pegarlo en .env si vas a levantar con Docker
# ====================================================
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

database.default.hostname = db
database.default.database = transitomunicipal
database.default.username = root
database.default.password = root
database.default.DBDriver = MySQLi
database.default.port = 3306

# Token de la Plataforma de Interoperabilidad del Estado (PIDE) para consultas RENIEC/SUNAT.
# Nunca commitear el valor real: solo va en tu .env local.
pide.baseUrl = 'https://pide.munijlo.gob.pe/api/v1'
pide.token = ''


# ====================================================
# LOCAL SIN DOCKER: backend corriendo en tu PC y DB del compose publicada en 3307
# Copiar este bloque y pegarlo en .env
# ====================================================
# CI_ENVIRONMENT = development
# 
# app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false
# 
# database.default.hostname = 127.0.0.1
# database.default.database = transitomunicipal
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.port = 3307
# 
# La UIT vigente se configura en la tabla municipalidad_anio.
