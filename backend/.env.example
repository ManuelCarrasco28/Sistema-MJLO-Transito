# Backend (CodeIgniter 4) - Plantilla de Configuración
CI_ENVIRONMENT=production

# Base de Datos
database.default.hostname=localhost
database.default.database=transitomunicipal
database.default.username=root
database.default.password=
database.default.DBDriver=MySQLi
database.default.port=3306

# URL base del Backend
app.baseURL=https://transito.munijlo.gob.pe/

# Orígenes permitidos (CORS / CSRF) separados por coma
app.corsAllowedOrigins=https://transito.munijlo.gob.pe

# Cookies seguras
cookie.secure=true
cookie.httponly=true
cookie.samesite=Lax

# Claves de cifrado
app.sessionSecret=
encryption.key=
MOBILE_API_URL=https://transito.munijlo.gob.pe/api/v1
