# Mantener el código de migraciones versionado; la regla anterior evita dumps
# locales llamados Database, pero no debe ocultar el código de la aplicación.
!backend/app/Database/
!backend/app/Database/Migrations/
!backend/app/Database/Migrations/*.php
# Los seeders son código fuente; su ejecución se realiza de forma explícita.
!backend/app/Database/Seeds/
!backend/app/Database/Seeds/*.php
*.sql
!database/
!database/migraciones/
!database/transitomunicipal.sql
!database/migraciones/*.sql

